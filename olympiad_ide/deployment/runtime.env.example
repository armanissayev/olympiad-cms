# Deployment template; substitute your separate IDE DB role and protected key reference.
IDE_AUTH_MODE=cms
CMS_INSTALLATION_ID=REPLACE_WITH_STABLE_INSTALLATION_UUID
CMS_ASSERTION_KEY_FILE=/etc/cms/ide-runtime-assertion.key
DATABASE_URL=postgresql+psycopg://ide_api:REPLACE_WITH_SECRET@127.0.0.1/olympiad_ide
ALLOWED_ORIGINS=https://contest.example.org
COOKIE_SECURE=true
TELEMETRY_RETENTION_DAYS=30
