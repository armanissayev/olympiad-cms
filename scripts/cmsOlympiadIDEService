#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# Native CMS service. The private ASGI runtime uses a separate interpreter.
import gevent.monkey
gevent.monkey.patch_all()  # noqa

import logging
import sys
from cms import ConfigError, default_argument_parser
from cms.server.olympiadide.server import OlympiadIDEService


def require_explicit_contest():
    raise ConfigError("Olympiad IDE requires an explicit numeric -c/--contest-id; interactive selection and ALL are unsupported")


def main():
    service = default_argument_parser("CMS-native Olympiad IDE (explicit numeric -c required; ALL unsupported).", OlympiadIDEService, ask_contest=require_explicit_contest)
    return 0 if service.run() is True else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ConfigError as error:
        logging.getLogger(__name__).critical(error)
        sys.exit(1)
